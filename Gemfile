# CSE 3901 Project 3 - Ruby API client with Tk
# Dependencies are pinned so every teammate installs the same versions.
# json ships with Ruby's standard library, so it is not listed here.

source "https://rubygems.org"

gem "httparty", "~> 0.24.3" # HTTP client for talking to the MockAPI REST endpoints
gem "tk", "~> 0.6.0"        # Tk bindings for the desktop GUI (requires system Tcl/Tk)
